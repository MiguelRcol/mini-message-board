<%- include("partials/header") %>

<section class="hero" aria-labelledby="page-title">
  <div class="hero-copy">
    <p class="eyebrow"><span></span> Community board</p>
    <h1 id="page-title">Leave a thought.<br /><em>Start an echo.</em></h1>
    <p class="hero-intro">
      A tiny corner of the internet for hellos, ideas, and everything in between.
    </p>
    <a class="button button-primary" href="/new">
      Write a message
      <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="hero-art" aria-hidden="true">
    <div class="orb orb-large"></div>
    <div class="orb orb-medium"></div>
    <div class="orb orb-small"></div>
    <div class="spark spark-one">✦</div>
    <div class="spark spark-two">✦</div>
    <div class="hero-note">say<br />something<br /><strong>kind</strong></div>
  </div>
</section>

<section class="messages-section" aria-labelledby="latest-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow"><span></span> From the community</p>
      <h2 id="latest-heading">Latest echoes</h2>
    </div>
    <p class="message-count"><strong><%= messages.length %></strong> messages shared</p>
  </div>

  <% if (messages.length === 0) { %>
    <div class="empty-state">
      <p>No messages yet. Be the first to say hello.</p>
      <a class="text-link" href="/new">Write the first message →</a>
    </div>
  <% } else { %>
    <div class="message-grid">
      <% messages.forEach((message, index) => { %>
        <article class="message-card" style="--card-index: <%= index %>">
          <div class="message-meta">
            <div class="avatar" aria-hidden="true"><%= message.user.charAt(0).toUpperCase() %></div>
            <div>
              <h3><%= message.user %></h3>
              <time datetime="<%= message.added.toISOString() %>"><%= formatDate(message.added) %></time>
            </div>
          </div>
          <p class="message-text"><%= message.text %></p>
          <a class="open-link" href="/messages/<%= message.id %>" aria-label="Open message from <%= message.user %>">
            Open message <span aria-hidden="true">→</span>
          </a>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include("partials/footer") %>
