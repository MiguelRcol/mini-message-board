<%- include("partials/header") %>

<section class="form-page">
  <div class="form-intro">
    <a class="back-link" href="/">← Back to all messages</a>
    <p class="eyebrow"><span></span> Add your voice</p>
    <h1>What’s on<br />your <em>mind?</em></h1>
    <p>Share a thought with the board. Short, sweet, and human works best.</p>
    <div class="form-decoration" aria-hidden="true">
      <span>✦</span>
      <div>hello!</div>
    </div>
  </div>

  <div class="form-card">
    <div class="form-card-heading">
      <span>New echo</span>
      <span aria-hidden="true">01</span>
    </div>

    <% if (error) { %>
      <p class="form-error" role="alert"><%= error %></p>
    <% } %>

    <form method="POST" action="/new">
      <div class="field">
        <label for="messageUser">Your name</label>
        <input
          id="messageUser"
          name="messageUser"
          type="text"
          value="<%= values.messageUser || '' %>"
          placeholder="e.g. Ada"
          maxlength="50"
          autocomplete="name"
          required
        />
      </div>

      <div class="field">
        <label for="messageText">Your message</label>
        <textarea
          id="messageText"
          name="messageText"
          placeholder="Leave something worth echoing..."
          maxlength="500"
          rows="6"
          required
        ><%= values.messageText || '' %></textarea>
        <small>Up to 500 characters</small>
      </div>

      <button class="button button-primary submit-button" type="submit">
        Share your message <span aria-hidden="true">↗</span>
      </button>
    </form>
  </div>
</section>

<%- include("partials/footer") %>
